#define ARCADIA_MATH_MODULE (1)
#include "Arcadia/Math/AxisAngle@{dimensionality}@{scalarSuffix}.h"

static void
Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix}_constructImpl
  (
    Arcadia_Thread* thread,
    Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix}* self
  );

static const Arcadia_ObjectType_Operations _objectTypeOperations = {
  Arcadia_ObjectType_Operations_Initializer,
  .construct = (Arcadia_Object_ConstructCallbackFunction*)&Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix}_constructImpl,
  .initializeDispatch = (Arcadia_ObjectDispatch_InitializeCallbackFunction*)&Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix}_initializeDispatchImpl,
  .visit = (Arcadia_ObjectDispatch_VisitCallbackFunction*)&Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix}_visitImpl,
};

static const Arcadia_Type_Operations _typeOperations = {
  Arcadia_Type_Operations_Initializer,
  .objectTypeOperations = &_objectTypeOperations,
};

Arcadia_defineObjectType(u8"Arcadia.Math.AxisAngle@{dimensionality}@{scalarSuffix}", Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix},
                         u8"Arcadia.Object", Arcadia_Object,
                         &_typeOperations);
                         
static void
Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix}_constructImpl
  (
    Arcadia_Thread* thread,
    Arcadia_TemplateEngine_Diagnostics_UnclosedStringLiteralDiagnostic* self
  )
{
  Arcadia_EnterConstructor(Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix});
  if (2 != _numberOfArguments) {
    Arcadia_Thread_setStatus(thread, Arcadia_Status_NumberOfArgumentsInvalid);
    Arcadia_Thread_jump(thread);
  }
  {
    Arcadia_ValueStack_pushNatural8Value(thread, 0);
    Arcadia_superTypeConstructor(thread, _type, self);
  }
  self->axis = Arcadia_ValueStack_getObjectReferenceValue(thread, 2, _Arcadia_Math_Vector@{dimensionality}@{scalarSuffix}_getType(thread));
  self->axis = (Arcadia_Math_Vector@{dimensionality}@{scalarSuffix}*)Arcadia_Object_clone(thread, self->axis);
  Arcadia_Math_Vector@{dimensionality}@{scalarSuffix}_normalize(thread, self->axis);
  self->angle = Arcadia_ValueStack_get@{scalarSuffix}Value(thread, 1);
  // (1) Normalize the axis.
  Arcadia_Math
  // (2) Normalize the angle.
  while (self->angle <= -@{threeHundredSixtyScalarLiteral}) {
    self->angle += @{threeHundredSixtyScalarLiteral};
  } 
  while (self->angle >= +@{threeHundredSixtyScalarLiteral}) {
    self->angle -= @{threeHundredSixtyScalarLiteral};
  }
  Arcadia_LeaveConstructor(Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix});
}

Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix}*
Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix}_create
  (
    Arcadia_Thread* thread,
    Arcadia_Math_Vector@{dimensionality}@{scalarSuffix}* axis,
    @{scalarType} angle
  )
{
  _Arcadia_BeginCreate(Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix});
  Arcadia_ValueStack_pushObjectValue(thread, axis);
  Arcadia_ValueStack_push@{scalarSuffix}Value(thread, angle);
  Arcadia_ValueStack_pushNatural8Value(thread, 2);
  _Arcadia_EndCreate(Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix});
}

Arcadia_Math_Vector@{dimensionality}@{scalarSuffix}*
Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix}_getAxis
  (
    Arcadia_Thread* thread,
    Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix}* self
  )
{
  Arcadia_Math_Vector@{dimensionality}@{scalarSuffix}* axis = Arcadia_Math_Vector@{dimensionality}@{scalarSuffix}_create(thread);
  Arcadia_Math_Vector@{dimensionality}@{scalarSuffix}_assign(thread, axis, self->axis);
}

@{scalarType}
Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix}_getAngle
  (
    Arcadia_Thread* thread,
    Arcadia_Math_AxisAngle@{dimensionality}@{scalarSuffix}* self
  )
{ return self->angle; }
